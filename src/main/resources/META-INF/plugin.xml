<idea-plugin>
    <id>pl.mario.intellij.mcp</id>
    <name>intellij-mcp-addons</name>
    <version>0.2.0</version>
    <vendor>Mario</vendor>
    <description>Extends the IntelliJ MCP server with process execution control, run output reading and Maven reload/introspection tools.</description>
    <idea-version since-build="262"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>intellij.testRunner.plugin</depends>
    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolset implementation="pl.mario.intellij.mcp.RunControlToolset"/>
        <mcpServer.mcpToolset implementation="pl.mario.intellij.mcp.MavenControlToolset"/>
    </extensions>
    <projectListeners>
        <listener class="pl.mario.intellij.mcp.RunHistoryExecutionListener" topic="com.intellij.execution.ExecutionListener"/>
        <listener class="pl.mario.intellij.mcp.RunHistoryTestListener" topic="com.intellij.execution.testframework.sm.runner.SMTRunnerEventsListener"/>
    </projectListeners>
</idea-plugin>
